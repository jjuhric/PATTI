PORT=3000
JWT_SECRET=placeholder_dev_secret_key_patti_assistant_2026
DB_PATH=backend/database.db
DB_ENCRYPTION_SECRET=placeholder_change_this_to_a_random_secret

# Optional Device Defaults
ESP32_DEFAULT_IP=
GOOGLE_HOME_IP=

LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_KEY=placeholder_sk-lm-key
PREFERRED_LOCAL_MODEL=google/gemma-4-e4b
PREFERRED_ONLINE_MODEL=google/gemma-4-e4b
SUPERVISOR_MODEL=google/gemma-4-e4b

# AI Model Configuration
OPENAI_API_MODEL="google/gemma-4-e4b"
AI_MAX_TOKENS=16384

# Optional online provider fallback keys (never used unless you enable
# "Use Online Model Fallback" in Settings and pick the matching provider).
# These are just an env-var alternative to typing a key into Settings -
# leave blank if you'd rather link an account through the UI instead.
GEMINI_API_KEY=placeholder_gemini_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_NODE_ID=windows-main
MQTT_USERNAME=
MQTT_PASSWORD=

# Tool Registry Configuration (local tool install/discovery, no remote sync)
TOOL_REGISTRY_LOCAL_PATH=./tool_registry

# Standalone Python deep-research scraper project (sibling folder) used by the
# deep_research_pro tool for thorough background research / study-guide generation.
# Leave blank to disable that tool. Expects <dir>\.venv\Scripts\python.exe to exist
# (override the interpreter path directly with DEEP_RESEARCH_SCRAPER_PYTHON if not).
DEEP_RESEARCH_SCRAPER_DIR=
