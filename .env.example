PORT=3000
JWT_SECRET=placeholder_dev_secret_key_patti_assistant_2026
DB_PATH=backend/database.db
DB_ENCRYPTION_SECRET=placeholder_change_this_to_a_random_secret

# Device role: IS_HOST=true + PATTI_ROLE=host is the machine running the LLM (today's
# default setup). IS_HOST=true + PATTI_ROLE=client is a PATTI Client - a second full PATTI
# instance (its own UI/chat history/DB) that has no LLM of its own and routes every
# generation request through the host's LLM via HOST_BRIDGE_URL/HOST_BRIDGE_SECRET, subject
# to host-wins arbitration. IS_HOST=false is a lightweight Node (sensor/actuator device,
# unchanged - see node_client/).
IS_HOST=true
PATTI_ROLE=host
HOST_BRIDGE_URL=
HOST_BRIDGE_SECRET=

# Optional Device Defaults
ESP32_DEFAULT_IP=
GOOGLE_HOME_IP=

LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_KEY=placeholder_sk-lm-key
PREFERRED_LOCAL_MODEL=google/gemma-4-e4b
PREFERRED_ONLINE_MODEL=google/gemma-4-e4b
SUPERVISOR_MODEL=google/gemma-4-e4b

# AI Model Configuration
OPENAI_API_MODEL="google/gemma-4-e4b"
AI_MAX_TOKENS=16384

# Optional online provider fallback keys (never used unless you enable
# "Use Online Model Fallback" in Settings and pick the matching provider).
# These are just an env-var alternative to typing a key into Settings -
# leave blank if you'd rather link an account through the UI instead.
GEMINI_API_KEY=placeholder_gemini_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The Movie Database, used by the Movie & TV agent for streaming availability,
# release dates, and ratings. This is the v4 "API Read Access Token" (a long
# token beginning with "eyJ"), NOT the shorter v3 API key - PATTI sends it as a
# Bearer header. Get one free at https://www.themoviedb.org/settings/api
# Without it, the Movie & TV agent reports that it is not configured.
TMDB_API_KEY=

# Tavily Search API (https://tavily.com), used by web_search_tool.js as the primary web search
# backend - relevance-scored results, native news search, no HTML-scraping fragility. Free tier:
# 1,000 credits/month, no credit card. Sign up at tavily.com and copy the key from the dashboard.
# Without it, web search falls back to scraping DuckDuckGo/Google/Wikipedia directly (works, but
# far less reliable).
TAVILY_API_KEY=

# Local LLM reliability tuning (optional - sensible defaults are built in).
# LOCAL_LLM_TIMEOUT_MS: how long to wait on a local generation. Must comfortably
#   exceed a cold model load, or requests arriving after an idle unload fail.
# LLM_RETRY_BACKOFF_MS: pause before retrying a failed generation, so the retry
#   isn't spent on a model that is still loading.
# IDLE_UNLOAD_MS: how long the system must sit idle before loaded models are
#   freed from VRAM. Lower reclaims memory sooner but makes cold reloads common.
LOCAL_LLM_TIMEOUT_MS=180000
LLM_RETRY_BACKOFF_MS=5000
IDLE_UNLOAD_MS=900000

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_NODE_ID=windows-main
MQTT_USERNAME=
MQTT_PASSWORD=

# Tool Registry Configuration (local tool install/discovery, no remote sync)
TOOL_REGISTRY_LOCAL_PATH=./tool_registry

# Standalone Python deep-research scraper project (sibling folder) used by the
# deep_research_pro tool for thorough background research / study-guide generation.
# Leave blank to disable that tool. Expects <dir>\.venv\Scripts\python.exe to exist
# (override the interpreter path directly with DEEP_RESEARCH_SCRAPER_PYTHON if not).
DEEP_RESEARCH_SCRAPER_DIR=
